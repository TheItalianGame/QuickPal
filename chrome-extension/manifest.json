{
  "manifest_version": 3,
  "name": "QuickPal Chrome Tabs",
  "description": "Shares open Chrome tabs with QuickPal and lets QuickPal focus them.",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "key": ""
}
