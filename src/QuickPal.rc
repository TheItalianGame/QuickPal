#include <windows.h>
#include "QuickPalVersion.h"

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION QUICKPAL_VERSION_MAJOR,QUICKPAL_VERSION_MINOR,QUICKPAL_VERSION_PATCH,QUICKPAL_VERSION_BUILD
PRODUCTVERSION QUICKPAL_VERSION_MAJOR,QUICKPAL_VERSION_MINOR,QUICKPAL_VERSION_PATCH,QUICKPAL_VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QuickPal"
            VALUE "FileDescription", "QuickPal native command palette"
            VALUE "FileVersion", QUICKPAL_VERSION_STRING
            VALUE "InternalName", "QuickPal"
            VALUE "OriginalFilename", "QuickPal.exe"
            VALUE "ProductName", "QuickPal"
            VALUE "ProductVersion", QUICKPAL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
